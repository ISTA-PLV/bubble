module

public meta import Bubble.Core.Plat
public meta import Bubble.Search.Names
public meta import Bubble.Search.SearchM

public meta section

namespace Bubble.Search

open Lean Meta Qq
open Iris.BI Iris.ProofMode

variable {Q : Type} [Queue Q]

/--
  Propagate a footprint through a Goal or Rapp.
  Resources generated by the step are local to it, while resources consumed by
  the step become visible above it.
  F'= (F \ gen) ∪ consumed
-/
private def propagateFootprint (rising generated consumed : Array IrisHyp) :
    SearchM Q (Array IrisHyp) := do
  let same? := λ lhs rhs : IrisHyp => lhs.ivar == rhs.ivar
  let afterRemoved := rising.filter λ used => !generated.any (same? used)
  (afterRemoved ++ consumed).foldlM (init := #[]) λ result used => do
    if result.any (same? used) then throwError
      "ibubble: footprint invariant violated: resource {used} occurs more than once"
    return result.push used

/- A spatial hypothesis introduced while normalizing a goal cannot escape above
its normalization step. It must be consumed below, be individually discardable,
or remain under an absorbing target. -/
private def generatedHypsAreAccountedFor (goal : Goal)
    (rising : RisingBubble) : MetaM Bool := do
  let .normal postGoal postState generated _ := goal.normalizationState
    | return true
  let unused := generated.filter fun hyp =>
    !rising.consumed.any fun consumed => consumed.ivar == hyp.ivar
  if unused.isEmpty then return true
  postState.runMetaM' do
    postGoal.withContext do
      let type ← instantiateMVars (← postGoal.getType)
      let some ⟨_, prop, bi, _, hyps, target⟩ := parseIrisGoal? type | return false
      let targetAbsorbing ← withoutModifyingState do
        return (match ← trySynthInstanceQ q(@Absorbing $prop $bi $target) with
          | .some _ => true
          | .none | .undef => false)
      if targetAbsorbing then return true
      let entries := spatialHypEntries hyps
      for hyp in unused do
        let some (_, _, type) := entries.find? fun (_, ivar, _) => ivar == hyp.ivar
          | return false
        have type : Q($prop) := type
        let affine ← withoutModifyingState do
          return (match ← trySynthInstanceQ q(@Affine $prop $bi $type) with
            | .some _ => true
            | .none | .undef => false)
        unless affine do return false
      return true

/--
  Convert one risingBubble to bubble that can be recorded in the TreeM
-/
private def registerBubble (goal : Goal) (rising : RisingBubble) :
    SearchM Q Bubble := do
  let bubble : Bubble := {
    id := ← TreeM.getAndIncrementNextBubbleId
    goal := goal.id
    consumed := rising.consumed
    metaInfo := rising.metaInfo
    pre? := goal.pre?
    endKind := rising.endKind
    forward := rising.forward
  }
  TreeM.addBubble bubble
  return bubble

mutual

/--
  Collect the normalization effects recorded by this `Goal` node.
-/
private partial def passThroughGoal (goalRef : GoalRef) (rising : RisingBubble) :
    SearchM Q Unit := do
  let goal ← goalRef.get
  unless ← generatedHypsAreAccountedFor goal rising do
    trace[ibubble.search]
      "goal {goal.id} rejected a proof that leaves a generated spatial hypothesis unused"
    return
  let postState ← match goal.normalizationState with
    | .normal _ state .. => pure state
    | .provenByNorm state .. => pure state
    | .notNormal => throwError
        "ibubble: a rising bubble cannot pass through a goal before normalization"
  let incomingMVars ← goal.preNormState.runMetaM' do
    goal.preNormGoal.getMVarDependencies
  let normalizationMeta ← Bubble.Meta.collectMetaInfo incomingMVars postState
  let some metaInfo ← Bubble.Meta.mergeMetaInfo postState #[rising.metaInfo, normalizationMeta]
    | do
      trace[ibubble.search] "goal {goal.id} rejected incompatible normalization assignments"
      return
  let consumed ← propagateFootprint rising.consumed
    goal.normalizationState.generatedSpatialHyps
    goal.normalizationState.usedSpatialHyps
  passThroughPlat goalRef goal { rising with consumed, metaInfo }

/--
  Collect the rule application effects recorded by current `Rapp` node.
-/
private partial def passThroughRapp (rappRef : RappRef) (rising : RisingBubble) :
    SearchM Q Unit := do
  let rapp ← rappRef.get
  /- M' = (M \ introduced) ∪ assigned. -/
  let some metaInfo ← Bubble.Meta.propagateMetaInfo rapp.metaState rising.metaInfo
      rapp.introducedMVars rapp.assignedMVars
    | do
      trace[ibubble.search]
        "Rapp {rapp.id} rejected incompatible metavariable assignments"
      return
  let consumed ← propagateFootprint rising.consumed
    rapp.generatedSpatialHyps rapp.consumedSpatialHyps
  -- Rapp's nodeId needed to be recorded for proof reconstruction
  passThroughGoal rapp.parent {
    rising with forward := #[rapp.id] ++ rising.forward, consumed, metaInfo
  }

/--
  A rising bubble can pass through three kinds of platforms:
  (1) single: treat the platform as transparent;
  (2) unrestricted: register the bubble;
  (3) linear: register the bubble, enforce linearity restrictions, and consider generating
      dependent groups.
-/
private partial def passThroughPlat (goalRef : GoalRef) (goal : Goal)
    (rising : RisingBubble) : SearchM Q Unit := do
  let plat ← goal.parent.get
  trace[ibubble.search]
    "rising proof reached goal {goal.id}, platform {plat.id} ({plat.kind}), footprint size {rising.consumed.size}"
  /- The bubble has reached the root; accept it if its resource footprint is compatible. -/
  if plat.parent?.isNone then
    goal.preNormState.runMetaM' do
      goal.preNormGoal.withContext do
        let type ← instantiateMVars (← goal.preNormGoal.getType)
        let some { hyps, .. } := parseIrisGoal? type
          | throwError
              "ibubble: the bubble reached the root, but the root is not an Iris proof-mode goal"
        let used := rising.consumed.map (·.ivar)
        let spatial := (spatialHypEntries hyps).map λ (_, ivar, _) => ivar
        /- Every resource in the rising footprint must belong to the root's
        spatial context: `used ⊆ spatial`. -/
        unless used.all spatial.contains do
          throwError
            "ibubble: footprint invariant violated: the rising bubble contains a resource outside the root context"
    let bubble ← registerBubble goal rising
    /- The root accepted the bubble—the search succeeded! 🥳 -/
    TreeM.setResult bubble.id
  else if plat.kind.isSingle then
    let some rappRef := plat.parent?
      | throwError "ibubble: a non-root single platform has no parent Rapp"
    passThroughRapp rappRef rising
  else
    let some rappRef := plat.parent?
      | throwError "ibubble: a non-root platform has no parent Rapp"
    let bubble ← registerBubble goal rising
    let iteration ← SearchM.getIteration
    /- Invoke `Plat.arriveBubble` to generate all new goals and bubbles -/
    trace[ibubble.search] "platform {plat.id} registering bubble {bubble.id}"
    let (emissions, residualGoals) ← Plat.arriveBubble iteration goalRef bubble
    trace[ibubble.search]
      "platform {plat.id} produced {emissions.size} emission(s) and {residualGoals.size} residual goal(s)"
    unless residualGoals.isEmpty do
      SearchM.enqueueGoals residualGoals
    emissions.forM λ emission =>
      passThroughRapp rappRef {
        endKind := .platformEmission emission.bubbles
        consumed := emission.consumed
        metaInfo := emission.metaInfo
      }

end

/- A Rapp with no subgoals starts a new rising proof directly. -/
def emitRappBubble (rappRef : RappRef) : SearchM Q Unit := do
  passThroughRapp rappRef { endKind := .ruleApplication }

/--
  Normalization can close a goal through `simp`. Start propagation through
  `passThroughGoal`.
-/
def emitNormalizationBubble (goalRef : GoalRef) : SearchM Q Unit := do
  let goal ← goalRef.get
  unless goal.normalizationState.isProvenByNorm do
    throwError
      "ibubble: cannot emit a normalization bubble unless normalization closed the goal"
  passThroughGoal goalRef { endKind := .normalization }

end Bubble.Search
